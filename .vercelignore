backend/config.dev.yaml
backend/secrets/

# 빌드·테스트 부산물
node_modules/
frontend/dist/
__pycache__/
*.pyc
.pytest_cache/

# 서버리스 함수에 필요 없는 것들
backend/tests/
backend/scripts/
deploy/
picture/
